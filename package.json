{
  "name": "cypress-ecommerce-automation",
  "version": "1.0.0",
  "description": "Cypress and TypeScript end-to-end tests for a public e-commerce application",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed --browser chrome",
    "test:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "cypress": "15.3.0",
    "typescript": "5.9.2"
  }
}
